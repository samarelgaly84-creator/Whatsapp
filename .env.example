# GEMINI_API_KEY: Required for TIGER AI & TIGER DRIVE AI (Gemini server-side SDK).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of verified admin email addresses for server-side Admin API access.
ADMIN_EMAILS="samarelgaly84@gmail.com"

# STRIPE_SECRET_KEY: Optional. When configured, enables live server-verified Stripe Checkout for TIGER PLUS & PRO plans.
# Plans are never activated without server-verified payment confirmation.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional. Used to verify Stripe webhook signatures for subscription activation.
STRIPE_WEBHOOK_SECRET=""

# CLOUD_UPLOAD_MAX_MB: Optional max upload size in MB for TIGER CLOUD & media uploads (default: 50).
CLOUD_UPLOAD_MAX_MB="50"
